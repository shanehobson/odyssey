# Copy to .env (gitignored) and fill in your own values. Nothing here is secret;
# AWS credentials come from an AWS CLI profile, never from this file.

AWS_PROFILE=your-profile
AWS_REGION=us-west-2

# Custom domain served by CloudFront (apex + www). The Route 53 hosted zone and an
# ACM certificate in us-east-1 covering both names must already exist.
DOMAIN_NAME=example.com
HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000

# Optional: extra origins allowed to call the Function URL directly (comma separated)
# EXTRA_CORS_ORIGINS=https://d1234567890abc.cloudfront.net

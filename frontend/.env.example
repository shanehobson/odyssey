# Copy to .env (gitignored). Values are examples; nothing here is a real credential.

# OpenRouteService API key for road routing (https://openrouteservice.org/dev/#/signup, free tier)
# Note: VITE_* variables are bundled into the browser build and are visible to users.
VITE_OPENROUTESERVICE_API_KEY=

# Optional: call a deployed backend directly instead of through the dev proxy
# VITE_API_URL=

# Dev proxy (npm run dev): where /api and /auth are forwarded. Not VITE_-prefixed on purpose:
# these never reach the browser bundle.
DEV_PROXY_TARGET=https://<your-function-url-or-cloudfront-host>
# Cookie domain set by the backend (COOKIE_DOMAIN in the stack); rewritten to localhost
DEV_PROXY_COOKIE_DOMAIN=example.com
# The CloudFront->origin shared secret (SSM /odyssey/edge-shared-secret); required by the backend
DEV_PROXY_BFF_AUTH=
